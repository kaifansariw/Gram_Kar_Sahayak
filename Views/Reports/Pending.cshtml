@model GramKar.Models.ViewModels.PendingReportViewModel
@{
    ViewData["Title"] = Loc["PendingDues"];
    bool isAdmin = User.IsInRole("Admin");
}

<div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px; margin-bottom: 24px;">
    <div>
        <h1 style="font-size: 32px; margin: 0;">⚠️ @Loc["PendingDues"]</h1>
        <div style="color: var(--muted); font-size: 16px;">@Loc["DefaultersPageSubtitle"]</div>
    </div>
    <div style="display: flex; gap: 10px;">
        <a asp-action="PrintPending"
           asp-route-financialYear="@Model.Filter.FinancialYear"
           asp-route-ward="@Model.Filter.Ward"
           asp-route-taxTypeId="@Model.Filter.TaxTypeId"
           asp-route-minAmount="@Model.Filter.MinAmount"
           asp-route-sortBy="@Model.Filter.SortBy"
           target="_blank" class="btn-brutal btn-turmeric-brutal">
            @Loc["Print"]
        </a>
        <a asp-action="ExportCsv"
           asp-route-financialYear="@Model.Filter.FinancialYear"
           asp-route-ward="@Model.Filter.Ward"
           asp-route-taxTypeId="@Model.Filter.TaxTypeId"
           asp-route-minAmount="@Model.Filter.MinAmount"
           asp-route-sortBy="@Model.Filter.SortBy"
           class="btn-brutal btn-success-brutal">
            @Loc["ExportCsv"]
        </a>
    </div>
</div>

<!-- Filters Card -->
<div class="card-brutal" style="padding: 22px; margin-bottom: 24px;">
    <form method="get" asp-action="Pending">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 14px; align-items: flex-end;">
            <div class="form-group-brutal" style="margin: 0;">
                <label class="form-label-brutal" style="font-size: 15px;">@Loc["FinancialYear"]</label>
                <select name="financialYear" class="form-select-brutal" style="min-height: 46px;">
                    <option value="All">@Loc["AllYears"]</option>
                    @foreach (var y in Model.AvailableYears)
                    {
                        <option value="@y" selected="@(Model.Filter.FinancialYear == y)">@y</option>
                    }
                </select>
            </div>

            <div class="form-group-brutal" style="margin: 0;">
                <label class="form-label-brutal" style="font-size: 15px;">@Loc["Ward"]</label>
                <select name="ward" class="form-select-brutal" style="min-height: 46px;">
                    <option value="All">@Loc["AllWards"]</option>
                    @foreach (var w in Model.AvailableWards)
                    {
                        <option value="@w" selected="@(Model.Filter.Ward == w)">@w</option>
                    }
                </select>
            </div>

            <div class="form-group-brutal" style="margin: 0;">
                <label class="form-label-brutal" style="font-size: 15px;">@Loc["TaxType"]</label>
                <select name="taxTypeId" class="form-select-brutal" style="min-height: 46px;">
                    <option value="">@Loc["AllTaxes"]</option>
                    @foreach (var t in Model.AvailableTaxTypes)
                    {
                        <option value="@t.TaxTypeId" selected="@(Model.Filter.TaxTypeId == t.TaxTypeId)">@Loc.LocalizeTaxName(t.Name)</option>
                    }
                </select>
            </div>

            <div class="form-group-brutal" style="margin: 0;">
                <label class="form-label-brutal" style="font-size: 15px;">@Loc["MinAmountFilter"]</label>
                <input type="number" name="minAmount" value="@Model.Filter.MinAmount" placeholder="500"
                       class="form-input-brutal" style="min-height: 46px;" />
            </div>

            <div class="form-group-brutal" style="margin: 0;">
                <label class="form-label-brutal" style="font-size: 15px;">@Loc["SortByLabel"]</label>
                <select name="sortBy" class="form-select-brutal" style="min-height: 46px;">
                    <option value="amount_desc" selected="@(Model.Filter.SortBy == "amount_desc")">@Loc["SortHighest"]</option>
                    <option value="amount_asc" selected="@(Model.Filter.SortBy == "amount_asc")">@Loc["SortLowest"]</option>
                    <option value="oldest_due" selected="@(Model.Filter.SortBy == "oldest_due")">@Loc["SortOldest"]</option>
                </select>
            </div>

            <div>
                <button type="submit" class="btn-brutal btn-primary-brutal" style="width: 100%; min-height: 46px;">
                    @Loc["ApplyFilter"] →
                </button>
            </div>
        </div>
    </form>
</div>

<!-- Turmeric Summary Banner (Design.md 8.7) -->
<div class="card-brutal card-brutal-turmeric" style="padding: 20px 24px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 14px;">
    <div>
        <div style="font-size: 15px; font-weight: 800; color: #333;">@Loc["DefaulterSummaryHeading"]</div>
        <div style="font-size: 26px; font-weight: 800; color: var(--ink);">
            @Loc["TotalPendingAmountSummary"] <span style="color: var(--danger);">₹@Model.TotalPendingAmount.ToString("N0")</span>
            <span style="font-size: 20px; font-weight: 700; color: #222;">(@Model.TotalDefaulterCount @Loc["FromHousesCount"])</span>
        </div>
    </div>
    <div style="text-align: right; font-size: 16px; font-weight: 700;">
        <div>@Loc["IncludedLateFee"] <strong>₹@Model.TotalLateFeeAmount.ToString("N0")</strong></div>
    </div>
</div>

<!-- Defaulters Table -->
<div class="table-container-brutal">
    <table class="table-brutal">
        <thead>
            <tr>
                <th style="white-space: nowrap;">@Loc["HouseNo"]</th>
                <th style="white-space: nowrap;">@Loc["OwnerName"]</th>
                <th style="white-space: nowrap;">@Loc["Ward"]</th>
                <th style="white-space: nowrap;">@Loc["Mobile"]</th>
                <th style="min-width: 240px;">@Loc["TaxBreakdownCol"]</th>
                <th style="text-align: right; white-space: nowrap;">@Loc["LateFee"]</th>
                <th style="text-align: right; white-space: nowrap;">@Loc["TotalPending"]</th>
                <th style="white-space: nowrap;">@Loc["OldestDueCol"]</th>
                <th style="white-space: nowrap;">@Loc["Action"]</th>
            </tr>
        </thead>
        <tbody>
            @if (Model.Rows.Any())
            {
                @foreach (var row in Model.Rows)
                {
                    <tr>
                        <td style="white-space: nowrap;">
                            <span class="chip-brutal chip-partial" style="font-size: 15px; padding: 4px 10px;">
                                @row.HouseNo
                            </span>
                        </td>
                        <td>
                            <strong style="font-size: 16px;">@row.OwnerName</strong>
                        </td>
                        <td style="white-space: nowrap; font-weight: 600;">@row.Ward</td>
                        <td style="white-space: nowrap;">
                            @if (!string.IsNullOrEmpty(row.Mobile))
                            {
                                <a href="tel:@row.Mobile" style="text-decoration: none; font-weight: 700; color: var(--highlight);">
                                    @row.Mobile
                                </a>
                            }
                            else
                            {
                                <span style="color: var(--muted);">-</span>
                            }
                        </td>
                        <td style="min-width: 240px; max-width: 340px;">
                            @if (!string.IsNullOrEmpty(row.TaxBreakdown))
                            {
                                var items = row.TaxBreakdown.Contains(" | ")
                                    ? row.TaxBreakdown.Split(" | ", StringSplitOptions.RemoveEmptyEntries)
                                    : row.TaxBreakdown.Split(", ", StringSplitOptions.RemoveEmptyEntries);
                                <div style="display: flex; flex-direction: column; gap: 4px; max-height: 140px; overflow-y: auto; padding-right: 4px;">
                                    @foreach (var item in items)
                                    {
                                        <div style="font-size: 13px; font-weight: 700; color: #111; background: #FFF9E6; border: 1.5px solid #111; border-radius: 6px; padding: 3px 8px; line-height: 1.3; white-space: nowrap;">
                                            @item
                                        </div>
                                    }
                                </div>
                            }
                        </td>
                        <td style="text-align: right; font-weight: 800; white-space: nowrap; color: @(row.LateFeePending > 0 ? "var(--danger)" : "var(--muted)");">
                            ₹@row.LateFeePending.ToString("N0")
                        </td>
                        <td style="text-align: right; font-weight: 800; font-size: 19px; white-space: nowrap; color: var(--danger);">
                            ₹@row.TotalPending.ToString("N0")
                        </td>
                        <td style="white-space: nowrap;">
                            @if (row.OldestDueDate.HasValue)
                            {
                                <div style="font-weight: 700; margin-bottom: 4px;">@row.OldestDueDate.Value.ToString("dd/MM/yyyy")</div>
                                @if (row.DaysOverdue > 0)
                                {
                                    <span class="chip-brutal chip-pending" style="font-size: 12px; padding: 2px 8px;">
                                        @row.DaysOverdue @Loc["DaysOverdueBadge"]
                                    </span>
                                }
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                        <td style="white-space: nowrap;">
                            <div style="display: flex; gap: 6px;">
                                <a asp-controller="Households" asp-action="Details" asp-route-id="@row.HouseId" class="btn-brutal btn-sm-brutal">
                                    @Loc["Details"]
                                </a>
                                @if (isAdmin)
                                {
                                    <a asp-controller="Payments" asp-action="Create" asp-route-houseId="@row.HouseId" class="btn-brutal btn-sm-brutal btn-success-brutal">
                                        @Loc["CollectBtn"]
                                    </a>
                                }
                            </div>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="9" style="text-align: center; padding: 30px; color: var(--muted);">
                        @Loc["NoDefaultersFound"]
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
