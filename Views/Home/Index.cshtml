@{
    ViewData["Title"] = Loc["AppName"];
    var panchayat = ViewBag.Panchayat as GramKar.Models.Entities.PanchayatSetting;
}

<!-- 1. HERO SECTION -->
<section style="margin-bottom: 50px; padding-top: 10px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 40px; align-items: center;">
        <!-- Left: Text & CTA -->
        <div>
            <!-- <div style="margin-bottom: 16px;">
                <span class="chip-brutal chip-partial" style="font-size: 16px;">
                    ✨ @Loc["DigitalGovBadge"]
                </span>
            </div> -->
            
            <h1 style="font-size: clamp(34px, 5vw, 52px); font-weight: 800; line-height: 1.2; margin-bottom: 20px;">
                @Loc["HeroTitle1"] <mark class="hero-mark">@Loc["HeroHighlight"]</mark>, @Loc["HeroTitle2"]
            </h1>

            <p style="font-size: 20px; color: var(--muted); margin-bottom: 30px; max-width: 500px;">
                @Loc["HeroSubtitle"]
            </p>

            <div style="display: flex; gap: 16px; flex-wrap: wrap; margin-bottom: 30px;">
                <a asp-controller="Account" asp-action="Login" class="btn-brutal btn-primary-brutal">
                 @Loc["Login"] →
                </a>
                <a href="#check-dues-section" class="btn-brutal">
                @Loc["CheckMyDues"] ▾
                </a>
            </div>

            <div style="font-size: 16px; font-weight: 700; color: var(--muted);">
                @Loc["AnyQuestion"]
            </div>
        </div>

        <!-- Right: Framed Hero Illustration with Floating Stickers -->
        <div style="position: relative; max-width: 520px; margin: 0 auto; width: 100%;">
            <!-- Floating Sticker 1 (Top Right) -->
            <div class="sticker-card" style="top: -15px; right: 10px;">
                <span style="font-size: 20px;">✔</span>
                <span>@Loc["StickerReceipt"]</span>
            </div>

            <!-- Framed Village Illustration Box -->
            <div style="background: #ffffff; border: var(--border); border-radius: var(--radius-card); box-shadow: var(--shadow-lg); overflow: hidden; position: relative;">
                <div style="background-color: var(--turmeric); padding: 8px 14px; border-bottom: 3px solid #111; display: flex; align-items: center; justify-content: space-between;">
                    <div style="display: flex; gap: 6px;">
                        <span style="width: 12px; height: 12px; border-radius: 50%; background: #FF5F56; border: 1.5px solid #111; display: inline-block;"></span>
                        <span style="width: 12px; height: 12px; border-radius: 50%; background: #FFBD2E; border: 1.5px solid #111; display: inline-block;"></span>
                        <span style="width: 12px; height: 12px; border-radius: 50%; background: #27C93F; border: 1.5px solid #111; display: inline-block;"></span>
                    </div>
                    <div style="font-size: 13px; font-weight: 800;">@Loc["HeroCampusTitle"]</div>
                </div>
                <div style="padding: 10px; text-align: center;">
                    <img src="~/img/village_hero.svg" alt="Village Landscape and Panchayat" style="width: 100%; height: auto; display: block; border-radius: 12px;" />
                </div>
            </div>

            <!-- Floating Sticker 2 (Bottom Left) -->
            <div class="sticker-card" style="bottom: -15px; left: 10px; animation-delay: -2s; transform: rotate(2deg);">
                <span>@Loc["StickerSafe"]</span>
            </div>
        </div>
    </div>
</section>

<!-- 2. SARPANCH MESSAGE & HOW IT WORKS SECTION -->
<section style="margin-bottom: 60px;">
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px;">
        <!-- Left: Sarpanch Message Card -->
        <div class="card-brutal" style="background-color: #FFFDF8;">
            <div style="display: flex; align-items: center; gap: 18px; margin-bottom: 20px;">
                <div style="width: 80px; height: 80px; border: var(--border); border-radius: 50%; overflow: hidden; background: #FFC933; flex-shrink: 0; box-shadow: 3px 3px 0 #111;">
                    <img src="~/img/sarpanch.svg" alt="Sarpanch" style="width: 100%; height: 100%; object-fit: cover;" />
                </div>
                <div>
                    <span class="chip-brutal chip-paid" style="margin-bottom: 6px; font-size: 13px;">@Loc["SarpanchMessageTitle"]</span>
                    <h3 style="margin: 0; font-size: 22px;">@(panchayat?.SarpanchName ?? "શ્રી રમેશભાઈ પટેલ")</h3>
                    <div style="font-size: 15px; font-weight: 700; color: var(--muted);">@Loc["SarpanchDesignation"]</div>
                </div>
            </div>
            <div style="position: relative; padding-left: 24px; font-size: 18px; font-style: italic; color: #222; line-height: 1.6; border-left: 4px solid var(--primary);">
                "@Loc["SarpanchQuote"]"
            </div>
        </div>

        <!-- Right: 3 Numbered Steps (How It Works) -->
        <div class="card-brutal" id="how-it-works">
            <h2 style="margin-bottom: 24px; font-size: 26px;">
             @Loc["HowItWorksTitle"]
            </h2>

            <div class="step-item">
                <div class="step-number" style="background-color: var(--turmeric);">@Loc["Step1Num"]</div>
                <div>
                    <h4 style="margin: 0 0 4px 0; font-size: 19px;">@Loc["Step1Title"]</h4>
                    <p style="margin: 0; font-size: 16px; color: var(--muted);">@Loc["Step1Desc"]</p>
                </div>
            </div>

            <div class="step-item">
                <div class="step-number" style="background-color: var(--highlight); color: #fff;">@Loc["Step2Num"]</div>
                <div>
                    <h4 style="margin: 0 0 4px 0; font-size: 19px;">@Loc["Step2Title"]</h4>
                    <p style="margin: 0; font-size: 16px; color: var(--muted);">@Loc["Step2Desc"]</p>
                </div>
            </div>

            <div class="step-item" style="margin-bottom: 0;">
                <div class="step-number" style="background-color: var(--leaf); color: #fff;">@Loc["Step3Num"]</div>
                <div>
                    <h4 style="margin: 0 0 4px 0; font-size: 19px;">@Loc["Step3Title"]</h4>
                    <p style="margin: 0; font-size: 16px; color: var(--muted);">@Loc["Step3Desc"]</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3. FEATURE CARDS (3) -->
<section style="margin-bottom: 60px;" id="features">
    <div style="text-align: center; margin-bottom: 30px;">
        <span class="chip-brutal chip-partial">@Loc["FeatureHeaderBadge"]</span>
        <h2 style="font-size: 32px; margin-top: 8px;">@Loc["FeatureHeaderTitle"]</h2>
    </div>

    <div class="grid-3">
        <!-- Feature 1: House Tax -->
        <div class="card-brutal" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div class="icon-square turmeric" style="margin-bottom: 16px;">
                    🏠
                </div>
                <h3 style="font-size: 22px; margin-bottom: 10px;">@Loc["FeatureHouseTaxTitle"]</h3>
                <p style="font-size: 17px; color: var(--muted);">
                    @Loc["FeatureHouseTaxDesc"]
                </p>
            </div>
            <div style="border-top: 2px dashed #111; padding-top: 14px; font-weight: 700; font-size: 15px; color: var(--primary);">
                @Loc["FeatureHouseTaxRate"]
            </div>
        </div>

        <!-- Feature 2: Water Tax -->
        <div class="card-brutal" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div class="icon-square sky" style="margin-bottom: 16px;">
                    💧
                </div>
                <h3 style="font-size: 22px; margin-bottom: 10px;">@Loc["FeatureWaterTaxTitle"]</h3>
                <p style="font-size: 17px; color: var(--muted);">
                    @Loc["FeatureWaterTaxDesc"]
                </p>
            </div>
            <div style="border-top: 2px dashed #111; padding-top: 14px; font-weight: 700; font-size: 15px; color: var(--highlight);">
                @Loc["FeatureWaterTaxRate"]
            </div>
        </div>

        <!-- Feature 3: Official Receipt -->
        <div class="card-brutal" style="display: flex; flex-direction: column; justify-content: space-between;">
            <div>
                <div class="icon-square rose" style="margin-bottom: 16px;">
                    🧾
                </div>
                <h3 style="font-size: 22px; margin-bottom: 10px;">@Loc["FeatureReceiptTitle"]</h3>
                <p style="font-size: 17px; color: var(--muted);">
                    @Loc["FeatureReceiptDesc"]
                </p>
            </div>
            <div style="border-top: 2px dashed #111; padding-top: 14px; font-weight: 700; font-size: 15px; color: var(--leaf);">
                @Loc["FeatureReceiptRate"]
            </div>
        </div>
    </div>
</section>

<!-- 4. VILLAGE PEOPLE SECTION (Image Left, Text Right) -->
<section style="margin-bottom: 60px;">
    <div class="card-brutal" style="background-color: #FFFDF8; padding: 34px;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 30px; align-items: center;">
            <div>
                <img src="~/img/village_people.svg" alt="Villagers" style="width: 100%; height: auto; display: block; border-radius: 12px;" />
            </div>
            <div>
                <span class="chip-brutal chip-paid" style="margin-bottom: 10px;">@Loc["VillageBandBadge"]</span>
                <h2 style="font-size: 30px; margin-bottom: 16px;">
                    @Loc["VillageBandTitle"]
                </h2>
                <p style="font-size: 18px; color: var(--muted); margin-bottom: 24px;">
                    @Loc["VillageBandDesc"]
                </p>
                <a asp-controller="Account" asp-action="Login" class="btn-brutal btn-primary-brutal">
                    @Loc["PanchayatLoginBtn"]
                </a>
            </div>
        </div>
    </div>
</section>

<!-- 5. PUBLIC DUES LOOKUP CARD -->
<section style="margin-bottom: 60px;" id="check-dues-section">
    <div class="card-brutal card-brutal-turmeric" style="padding: 34px;">
        <div style="text-align: center; max-width: 650px; margin: 0 auto 24px auto;">
            <h2 style="font-size: 32px; margin-bottom: 8px;"> @Loc["LookupTitle"]</h2>
            <p style="font-size: 18px; margin: 0; color: #333;">
                @Loc["LookupSubtitle"]
            </p>
        </div>

        <div style="max-width: 650px; margin: 0 auto;">
            <form asp-controller="Home" asp-action="CheckMyDues" method="post" id="PublicDuesForm">
                @Html.AntiForgeryToken()
                <div style="display: grid; grid-template-columns: 1fr 1fr auto; gap: 12px; align-items: center; background: #fff; padding: 10px; border: var(--border); border-radius: var(--radius-btn); box-shadow: var(--shadow-sm);">
                    <input type="text" name="houseNo" placeholder="@Loc["HouseNoPlaceholder"]" required
                           class="form-input-brutal" style="min-height: 48px; border: none; box-shadow: none; padding: 0 10px; font-size: 17px;" />
                    <input type="tel" name="mobile" placeholder="@Loc["MobilePlaceholder"]"
                           class="form-input-brutal" style="min-height: 48px; border: none; border-left: 2px solid #ddd; box-shadow: none; padding: 0 10px; font-size: 17px;" />
                    <button type="submit" class="btn-brutal btn-primary-brutal" style="min-height: 48px; padding: 0 22px;">
                        @Loc["CheckBtn"]
                    </button>
                </div>
            </form>

            <div id="DuesLookupResult"></div>
        </div>
    </div>
</section>

<!-- 6. FAQ ACCORDION WITH TABS -->
<section style="margin-bottom: 40px;" id="faq">
    <div style="text-align: center; margin-bottom: 30px;">
        <!-- <span class="chip-brutal chip-partial">@Loc["FaqBadge"]</span> -->
        <h2 style="font-size: 32px; margin-top: 8px;">@Loc["FaqTitle"]</h2>
    </div>

    <div class="card-brutal" style="max-width: 850px; margin: 0 auto;">
        <!-- FAQ Pill Tabs -->
        <div style="display: flex; gap: 10px; flex-wrap: wrap; margin-bottom: 24px; border-bottom: 2px solid #111; padding-bottom: 16px;">
            <button type="button" class="btn-brutal btn-pill-brutal faq-tab-btn active" data-category="all" style="min-height: 38px; font-size: 16px;">
                @Loc["TabAll"]
            </button>
            <button type="button" class="btn-brutal btn-pill-brutal faq-tab-btn" data-category="general" style="min-height: 38px; font-size: 16px;">
                @Loc["TabGeneral"]
            </button>
            <button type="button" class="btn-brutal btn-pill-brutal faq-tab-btn" data-category="tax" style="min-height: 38px; font-size: 16px;">
                @Loc["TabTax"]
            </button>
            <button type="button" class="btn-brutal btn-pill-brutal faq-tab-btn" data-category="payment" style="min-height: 38px; font-size: 16px;">
                @Loc["TabPayment"]
            </button>
            <button type="button" class="btn-brutal btn-pill-brutal faq-tab-btn" data-category="receipt" style="min-height: 38px; font-size: 16px;">
                @Loc["TabReceipt"]
            </button>
        </div>

        <!-- FAQ Items -->
        <div class="faq-accordion-item" data-category="general">
            <div class="faq-header">
                <span>@Loc["FaqQ1"]</span>
                <span class="faq-chevron" style="color: var(--highlight);">▼</span>
            </div>
            <div class="faq-body" style="display: none;">
                @Loc["FaqA1"]
            </div>
        </div>

        <div class="faq-accordion-item" data-category="tax">
            <div class="faq-header">
                <span>@Loc["FaqQ2"]</span>
                <span class="faq-chevron" style="color: var(--highlight);">▼</span>
            </div>
            <div class="faq-body" style="display: none;">
                @Loc["FaqA2"]
            </div>
        </div>

        <div class="faq-accordion-item" data-category="payment">
            <div class="faq-header">
                <span>@Loc["FaqQ3"]</span>
                <span class="faq-chevron" style="color: var(--highlight);">▼</span>
            </div>
            <div class="faq-body" style="display: none;">
                @Loc["FaqA3"]
            </div>
        </div>

        <div class="faq-accordion-item" data-category="receipt">
            <div class="faq-header">
                <span>@Loc["FaqQ4"]</span>
                <span class="faq-chevron" style="color: var(--highlight);">▼</span>
            </div>
            <div class="faq-body" style="display: none;">
                @Loc["FaqA4"]
            </div>
        </div>
    </div>
</section>
