@model GramKar.Models.ViewModels.HouseholdEditViewModel
@{
    ViewData["Title"] = Loc["AddHousehold"];
}

<div style="max-width: 680px; margin: 0 auto;">
    <div style="margin-bottom: 20px;">
        <a asp-action="Index" class="btn-brutal btn-sm-brutal">
            ← @Loc["Back"]
        </a>
    </div>

    <div class="card-brutal" style="padding: 32px;">
        <h2 style="font-size: 28px; margin-bottom: 8px;">@Loc["AddHousehold"]</h2>
        <p style="color: var(--muted); font-size: 16px; margin-bottom: 24px;">
            @Loc["AddHouseholdSubtitle"]
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="toast-brutal toast-error">
                @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div>@error.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div class="grid-2">
                <div class="form-group-brutal">
                    <label asp-for="HouseNo" class="form-label-brutal">@Loc["HouseNo"] *</label>
                    <input asp-for="HouseNo" class="form-input-brutal" placeholder="@Loc["HouseNoPlaceholder"]" required />
                    <span asp-validation-for="HouseNo" style="color: var(--danger); font-size: 14px;"></span>
                </div>

                <div class="form-group-brutal">
                    <label asp-for="Ward" class="form-label-brutal">@Loc["Ward"] *</label>
                    <input asp-for="Ward" class="form-input-brutal" required />
                    <span asp-validation-for="Ward" style="color: var(--danger); font-size: 14px;"></span>
                </div>
            </div>

            <div class="form-group-brutal">
                <label asp-for="OwnerName" class="form-label-brutal">@Loc["OwnerName"] *</label>
                <input asp-for="OwnerName" class="form-input-brutal" required />
                <span asp-validation-for="OwnerName" style="color: var(--danger); font-size: 14px;"></span>
            </div>

            <div class="grid-2">
                <div class="form-group-brutal">
                    <label asp-for="GuardianName" class="form-label-brutal">@Loc["GuardianName"]</label>
                    <input asp-for="GuardianName" class="form-input-brutal" />
                </div>

                <div class="form-group-brutal">
                    <label asp-for="Mobile" class="form-label-brutal">@Loc["Mobile"]</label>
                    <input asp-for="Mobile" type="tel" class="form-input-brutal" />
                </div>
            </div>

            <div class="grid-2">
                <div class="form-group-brutal">
                    <label asp-for="PropertyType" class="form-label-brutal">@Loc["PropertyType"]</label>
                    <select asp-for="PropertyType" class="form-select-brutal">
                        <option value="Residential">@Loc["Residential"]</option>
                        <option value="Shop">@Loc["Shop"]</option>
                        <option value="Other">@Loc["Other"]</option>
                    </select>
                </div>

                <div class="form-group-brutal">
                    <label class="form-label-brutal">@Loc["HasWaterLabel"]</label>
                    <div style="display: flex; gap: 16px; margin-top: 14px;">
                        <label style="font-weight: 700; cursor: pointer;">
                            <input type="radio" asp-for="HasWater" value="true" /> @Loc["Yes"]
                        </label>
                        <label style="font-weight: 700; cursor: pointer;">
                            <input type="radio" asp-for="HasWater" value="false" /> @Loc["No"]
                        </label>
                    </div>
                </div>
            </div>

            <div style="display: flex; gap: 14px; margin-top: 24px;">
                <button type="submit" class="btn-brutal btn-success-brutal" style="flex: 1;">
                    @Loc["Save"]
                </button>
                <a asp-action="Index" class="btn-brutal" style="flex: 1;">
                    @Loc["Cancel"]
                </a>
            </div>
        </form>
    </div>
</div>
